# Copy this file to `.env` and fill in your values. `.env` is gitignored — never commit real secrets.

# ── Internal service passwords ──
# The MQTT broker and TimescaleDB that HomeForge runs in docker-compose. Pick your own.
MQTT_PASS=homeforge
POSTGRES_PASSWORD=change-me-to-a-strong-password

# ── Remote access (optional) ──
# If you expose HomeForge with a Cloudflare Tunnel, put your tunnel run-token here.
# Leave blank if you use another method (Tailscale, WireGuard, a reverse proxy, or local-only).
# See docs/REMOTE_ACCESS.md.
CF_TUNNEL_TOKEN=
